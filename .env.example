# Puerto del servidor
PORT=3000

# Modo de base de datos.
# "mongodb-memory" -> MongoDB embebido en memoria (pruebas, sin instalar nada).
# Dejar vacio -> usa MONGO_URI (Atlas o local).
DB_MODO=mongodb-memory

# Base de datos alternativa (MongoDB Atlas o local)
# MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/daem?retryWrites=true&w=majority

# Semilla secreta para firmar tokens JWT
JWT_SECRET=daem_clave_super_secreta_cambiar_en_produccion

# Credenciales del administrador inicial (creadas por el seed automatico)
SEED_ADMIN_RUT=11111111-1
SEED_ADMIN_CLAVE=admin123